{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow",
    "approvals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workflow": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "approvals": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "role",
          "by",
          "at",
          "source_ref"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "role": {
            "enum": [
              "spec-owner",
              "product-owner",
              "reviewer"
            ]
          },
          "by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  },
  "description": "Producer declaration only. Drivers validate stage/role pairs, uniqueness and actual review authority/freshness separately."
}
