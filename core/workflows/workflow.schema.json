{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
          },
          "outputs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
            }
          },
          "next": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          },
          "on_reject": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "on_fail": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "entry_gate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "deterministic": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "spec-structure",
                    "decisions-resolved",
                    "tasks-present",
                    "tasks-complete",
                    "verification-evidence",
                    "artifact-impact",
                    "outputs-present"
                  ]
                }
              },
              "approval_from": {
                "type": "string"
              }
            },
            "required": []
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "spec-owner",
                  "product-owner",
                  "reviewer"
                ]
              }
            },
            "required": [
              "role"
            ]
          }
        },
        "required": [
          "id",
          "owner",
          "next"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "stages"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manh0303/notth/workflow.schema.json",
  "description": "Shape contract. Consumers also validate unique stage IDs, registered owners, transitions, forward DAG and approval sources."
}
