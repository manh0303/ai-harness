{
  "schema_version": 1,
  "servers": [
    {
      "name": "repository-reader",
      "owner": "project-team",
      "purpose": "Read approved source and review metadata",
      "capabilities": ["read"],
      "scope": ["explicit-owner/explicit-repository"],
      "credential_source": "host-secret-store",
      "timeout_seconds": 30,
      "max_output_bytes": 65536,
      "write_actions": "disabled"
    }
  ]
}
